<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ metaTitle or title }}</title>
  <meta name="description" content="{{ description }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ metaTitle or title }}">
  <meta property="og:description" content="{{ shareText or description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="fr_BE">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/og-image.png' }}">
  <meta property="og:image:alt" content="{{ ogImageAlt or 'Logo du Forum Koekelbergeois' }}">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#contenu">{{ site.ui.skipLink }}</a>

  <header class="site-header">
    <div class="container site-header__inner">
      <a class="site-logo" href="/">
        <img src="/assets/logo-forum-koekelbergeois.webp" width="240" height="134" alt="{{ site.ui.headerLogoAlt }}">
      </a>
      <nav class="site-nav" aria-label="Menu principal">
        <ul>
          {%- for item in navigation %}
          <li><a href="{{ item.url }}"
            {%- if page.url == item.url %} aria-current="page"
            {%- elif item.url != "/" and page.url and page.url.startsWith(item.url) %} aria-current="true"
            {%- endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenu" class="site-main" tabindex="-1">
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <ul class="container site-footer__list">
      <li>{{ site.legalName }}</li>
      <li><span class="sep" aria-hidden="true">·</span>{{ site.places.forum.addressLine }}</li>
      <li><span class="sep" aria-hidden="true">·</span><a class="nowrap" href="{{ site.phone.href }}">{{ site.phone.display }}</a></li>
      <li><span class="sep" aria-hidden="true">·</span><a href="mailto:{{ site.email.address }}">{{ site.email.address | replace("@", "@<wbr>") | safe }}</a></li>
      <li><span class="sep" aria-hidden="true">·</span>Instagram&nbsp;{% include "partials/instagram-link.njk" %}</li>
      <li><span class="sep" aria-hidden="true">·</span><a href="/mentions-legales/">Mentions légales et vie privée</a></li>
    </ul>
  </footer>
</body>
</html>
